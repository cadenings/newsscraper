# Copy this file to .env and fill in your Supabase project's credentials.
# Find both values in your Supabase project: Settings -> API.
#
# Use the service_role key (NOT the anon/public key) — this is a trusted
# backend script, not a browser app. Never share this key or commit .env.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-service-role-key-here
